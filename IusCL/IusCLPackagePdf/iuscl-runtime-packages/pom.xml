<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>org.iuscl</groupId>
	<artifactId>iuscl-package-pdf</artifactId>
	<version>2.0.0</version>
	<packaging>jar</packaging>

	<name>IusCL Pdf Runtime Package</name>

	<url>https://iuscl.org</url>
	<organization>
		<name>IusCL.org</name>
	</organization>

	<properties>
		<!-- Build properties -->
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.release>22</maven.compiler.release>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<version>1.18.46</version>
			<scope>provided</scope>			
		</dependency>
		<dependency>
			<groupId>org.iuscl</groupId>
			<artifactId>iuscl-package-usr</artifactId>
			<version>2.0.0</version>
		</dependency>
		<dependency>
			<groupId>com.itextpdf</groupId>
			<artifactId>itextpdf</artifactId>
			<version>5.1.3</version>
		</dependency>		
	</dependencies>

	<build>
		<resources>
			<resource>
				<directory>../src/main</directory>
				<includes>
					<include>resources/**/*</include>
				</includes>
				<excludes>
					<exclude>resources/designintf/**/*</exclude>
				</excludes>
			</resource>
			<resource>
				<directory>../packages-common-files</directory>
				<includes>
					<include>META-INF/LICENSE.txt</include>
				</includes>
			</resource>
		</resources>

		<sourceDirectory>../src/main/java</sourceDirectory>

		<plugins>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.15.0</version>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>1.18.46</version>
						</path>
					</annotationProcessorPaths>
					<excludes>
						<exclude>org/iuscl/designintf/</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.5.1</version>
				<configuration>
					<archive>
						<manifestEntries>
							<Built-By>Maven from Eclipse</Built-By>
						</manifestEntries>
						<manifest>
							<addDefaultImplementationEntries>true</addDefaultImplementationEntries>
							<addClasspath>true</addClasspath>
						</manifest>
					</archive>
					<includes>
						<include>org/iuscl/**/*</include>
						<include>resources/**/*</include>
						<include>META-INF/LICENSE.txt</include>
					</includes>
					<excludes>
						<exclude>org/iuscl/designintf/**/*</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>